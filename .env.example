# Copy this file to .env and fill in the values you have. Every field below has a
# working default in backend/app/config.py — you only need to set the ones your
# local setup differs on (usually just the API keys).

# --- LLM ---------------------------------------------------------------------
# Required for anything that calls a chat model (the RAG graph, the supervisor,
# the reflection judge, evaluation). Get one at console.groq.com.
GROQ_API_KEY=

# Provider-qualified model string, as consumed by langchain's init_chat_model().
# Groq's catalog rotates — check console.groq.com/docs/models if this 404s.
CHAT_MODEL=groq:openai/gpt-oss-120b

# Optional. Only needed if you point CHAT_MODEL/VISION_MODEL/IMAGE_GEN_MODEL at
# OpenAI, or want the image_gen MCP tool (Groq has no image generation endpoint).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Data stores ---------------------------------------------------------------
QDRANT_URL=http://localhost:6333
POSTGRES_URL=postgresql://nexus:nexus@localhost:5432/nexus
# If port 6379 is already taken on your machine by another project, remap the
# host side in infra/docker/docker-compose.yml and update this to match.
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexus_dev

# --- Observability -------------------------------------------------------------
PUSHGATEWAY_URL=http://localhost:9091

# --- Non-agent API ---------------------------------------------------------------
# Comma-separated in the environment; parsed into a list. Include whatever port
# your frontend dev server actually runs on (see frontend/package.json's "dev"
# script) — a mismatch here breaks CORS with a generic "Failed to fetch".
CORS_ORIGINS=["http://localhost:3000"]
DEBUG=true

# JSON object mapping each API key to the tenant/user it resolves to, e.g.:
#   NEXUS_API_KEYS={"sk-acme-...":{"tenant_id":"acme","user_id":"u1","name":"Acme"}}
# Leave unset + DEBUG=true for an unauthenticated "default" tenant in local dev.
NEXUS_API_KEYS=

# --- MCP tool ecosystem ---------------------------------------------------------
# Required for the github MCP server (backend/app/mcp/servers.yaml) to be
# offered at all — omitted entirely, not just blank, if this isn't set.
GITHUB_TOKEN=

# Comma-separated domains the browser/fetch tools and sandboxed code are allowed
# to reach. Empty (the default) fails closed — nothing is reachable until you
# add domains here.
EGRESS_ALLOWED_DOMAINS=

# --- LangSmith (optional tracing) -----------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nexus

# --- Frontend (frontend/.env.local, not this file, but shown here for reference) -
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_ASSISTANT_ID=rag_chat
# NEXT_PUBLIC_NEXUS_TENANT_ID=acme
# NEXT_PUBLIC_NEXUS_USER_ID=u1
